# Chép file này thành .env rồi tự điền giá trị. KHÔNG commit .env.
# docker-compose.yml và Spring Boot (spring.config.import=optional:file:.env[.properties]) cùng đọc file này.

# PostgreSQL
DB_NAME=taskly
DB_USER=taskly
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/taskly

# JWT — chuỗi ngẫu nhiên tối thiểu 32 byte (ví dụ sinh bằng: openssl rand -base64 48)
JWT_SECRET=

# SMTP gửi email (đặt lại mật khẩu từ M3, lời mời từ M8) — Mailpit khi dev
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@taskly.local

# Link mời gửi cho người nhận
INVITE_LINK_BASE=taskly://join/

# Đăng nhập Google (M5) — Web client ID tạo ở Google Cloud Console (người dùng tự tạo và tự điền).
# Nhiều client ID cách nhau bởi dấu phẩy. Để trống = mọi yêu cầu đăng nhập Google bị từ chối (server vẫn chạy).
GOOGLE_CLIENT_IDS=
# Khoá mã hoá secret 2FA (AES-256-GCM): base64 của ĐÚNG 32 byte ngẫu nhiên. Sinh trong PowerShell rồi tự dán vào .env:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Thiếu thì server không khởi động. Mất / đổi khoá → người đã bật 2FA chỉ đăng nhập được bằng mã khôi phục.
TOTP_ENCRYPTION_KEY=

# Email → task (M13a). Người dùng tự có tên miền (MX trỏ về dịch vụ nhận thư: Mailgun / SendGrid / Postmark /
# Cloudflare Email Workers…) và tự dựng adapter gửi JSON đã parse tới POST /api/v1/integrations/email/inbound, ký
# X-Taskly-Signature = v1=hex(HMAC-SHA256(bí mật, X-Taskly-Timestamp + "." + body)).
# EMAIL_INBOX_DOMAIN: phần sau @ của địa chỉ nhận thư (để trống = inbox.taskly.local, chỉ để thử local).
EMAIL_INBOX_DOMAIN=
# Bí mật HMAC dùng chung với adapter (chuỗi ngẫu nhiên dài, sinh như JWT_SECRET). Để trống = webhook từ chối mọi yêu cầu.
EMAIL_INBOUND_WEBHOOK_SECRET=
# ---- M13b: đăng nhập Apple / Facebook (luồng web trên Android) — người dùng tự tạo app và tự điền.
# Services ID của "Sign in with Apple" (Apple Developer Program). Return URL đăng ký ở Apple phải là HTTPS công khai:
#   https://<domain-của-bạn>/api/v1/auth/apple/callback (dev: dùng tunnel HTTPS trỏ về cổng 8080).
APPLE_CLIENT_IDS=
# Facebook app (Meta for Developers): App ID + App Secret (bí mật) + Valid OAuth Redirect URI
#   = URL công khai của /api/v1/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

# ---- M13b: Calendar (Google Calendar API + Microsoft Entra cho Outlook). Token người dùng được mã hoá bằng TOTP_ENCRYPTION_KEY.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=
# Redirect URI đăng ký ở cả hai nhà cung cấp (mặc định http://localhost:8080/api/v1/calendar/oauth/callback)
CALENDAR_OAUTH_REDIRECT_URI=
# Tiền tố link calendar feed iCal (URL công khai; mặc định http://localhost:8080/api/v1/calendar/feed/)
CALENDAR_FEED_BASE_URL=
